# Google Cloud Console: enable Maps JavaScript API, Places API, and Directions API.
# Restrict browser key to your localhost/deployed domains and only the APIs you need.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY

# Optional Firebase Spark/free-tier setup for email/password authentication and shared reports.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
